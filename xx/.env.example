# ─── XX — environment ───
# Neon Postgres connection string (pooled). https://neon.tech
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL (auto-detected on Vercel; set for local dev if needed)
# AUTH_URL=http://localhost:3000

# Secret protecting the price-snapshot cron route
CRON_SECRET=
